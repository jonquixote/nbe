    "item.stop": { "stateChange": ["itemState"] },
    "show.start": { "stateChange": ["showState"], "deferred": ["timer"] },
    "show.stop": { "stateChange": ["showState"], "deferred": ["streamHealth"] },
    "show.load": { "stateChange": ["showState", "viewItem", "previewItem", "fallbackActive", "itemState"] },
    "show.unload": {},
    "show.preflight": {},
    "preview.set": { "stateChange": ["previewItem", "itemState"] },
    "item.arm": { "stateChange": ["itemState"] },
    "item.unarm": { "stateChange": ["itemState"] },
    "item.reset": { "stateChange": ["itemState"] },
    "scene.arm": {},
