{
  "name": "nbe-control-plane",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "NBE control plane \u2014 authoritative show-state owner and WebSocket command bus (SPEC v0.3.1 Sections 5, 16, 17)",
  "license": "MIT OR Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "node --import tsx --test $(ls src/*.test.ts | grep -v dress-rehearsal)",
    "typecheck": "tsc --noEmit",
    "gen:manifest-types": "node scripts/gen-manifest-types.mjs",
    "test:rehearsal": "node --import tsx --test src/dress-rehearsal.test.ts"
  },
  "dependencies": {
    "uuid": "^11.1.0",
    "ws": "^8.18.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "json-schema-to-typescript": "^16.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0"
  }
}
